# v&v library snapshots, mined inventories). Local-only — not tracked.
# vv-sources/: working scratch space for case-source mining (PDFs, papers,
*.bak
*.egg-info/
*.pyc
*.pyo
*.tar
*_API.json
# Exported conversation transcripts (/export) dropped under a case dir
cases/**/benchmark.txt
.DS_Store
# A compute host runs pytest in the tree it was handed, so this appears there
# and is extra by definition. Until it was listed here it was the only thing on
# either host that `check_host_tree.py` could not account for, which made the
# one class of drift that needs a person's eye look like it had five members.
.pytest_cache/
.sim/
.venv-*/
.venv/
/decode.py
/jobs/
# Harbor writes one job tree per launcher invocation; -o names it, so these
# multiplied at the repo root (jobs-screen, jobs-L1, jobs-gpt...) until the
# launcher started nesting them under results-local/jobs/ — being ignored, they
# never showed up in `git status` to make the clutter visible. Kept as a net for
# a `harbor run -o ...` issued by hand.
/jobs-*/
/logs/
