FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }

// Solver and residual tolerances are far below the discretisation error being
// measured (~1e-4 on the finest grid). If they were not, the three reported
// errors would describe the stopping criterion rather than the scheme, and the
// fitted order would be meaningless.
solvers
{
    p { solver GAMG; smoother GaussSeidel; tolerance 1e-12; relTol 0.001; }
    U { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-12; relTol 0.001; }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    pRefCell    0;
    pRefValue   0;
    residualControl { p 1e-10; U 1e-10; }
}

relaxationFactors { fields { p 0.3; } equations { U 0.7; } }
