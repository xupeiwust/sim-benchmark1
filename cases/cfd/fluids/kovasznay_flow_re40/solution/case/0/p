FoamFile { version 2.0; format ascii; class volScalarField; object p; }

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;

// Velocity is Dirichlet on every side, so pressure is determined only up to a
// constant: zeroGradient everywhere plus the pRefCell/pRefValue gauge in
// fvSolution. The scored quantity is a velocity error, so the gauge is free.
boundaryField
{
    sides        { type zeroGradient; }
    frontAndBack { type empty; }
}
