#!/usr/bin/env bash
# Reference entry point. Everything the contract asks for happens in
# run_study.py: three meshes, three converged solves, the error norm, and
# grid_convergence.csv.
set -euo pipefail
cd "$(dirname "$(realpath "$0")")"
if ! command -v blockMesh >/dev/null 2>&1; then
    set +u
    # shellcheck disable=SC1091
    source /usr/lib/openfoam/openfoam2412/etc/bashrc
    set -u
fi
exec python3 run_study.py
