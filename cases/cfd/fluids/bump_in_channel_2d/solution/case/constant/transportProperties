/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}

// Incompressible. Re = U * L / nu = 1 * 1 / 3.3333333e-7 = 3e6, which is the
// number the instruction states and the one NASA TMR states: "Re = 3 million
// based on length '1' of the grid".
//
// The two lengths in this case are different and must not be conflated. NASA's
// other one -- "the body reference length is 1.5 units" -- is what normalises
// the force (forceCoeffs Aref = 1.5, in system/controlDict); it is NOT the
// Reynolds length. Reading it as the Reynolds length gives nu = 1.5/3e6 =
// 5e-7, which is what this file held until issue #223: the oracle then ran at
// Re = 2e6 and read 6.8% high in cd_total, with its viscous drag 6.4% above
// CFL3D on the same grid. The nu here is also the one 0/omega's comment and
// tests/kpis.json's oracle_provenance already used to derive omega = 296.45.
//
// At M=0.2 the incompressible-vs-compressible Cf difference is ~1%.

transportModel  Newtonian;

nu              3.3333333e-07;
