/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions [0 2 -2 0 0 0 0];

// Free-stream turbulent kinetic energy at the intensity the task states,
// I = 0.077%:  k = 1.5 * (I * U)^2 = 1.5 * (7.7e-4 * 1)^2 = 8.8935e-7
internalField uniform 8.8935e-7;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 8.8935e-7;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 8.8935e-7;
        value           uniform 8.8935e-7;
    }
    wall
    {
        type            fixedValue;
        value           uniform 1e-12;
    }
    top
    {
        type            symmetry;
    }
    symLower
    {
        type            symmetry;
    }

    frontBack
    {
        type            empty;
    }
}
